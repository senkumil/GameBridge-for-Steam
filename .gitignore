# ==============================================================================
# GameBridge for Steam - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencias de Node.js y Gestores de Paquetes
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# 2. Registros y Logs
# ------------------------------------------------------------------------------
logs/
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Datos de Usuario y Estado en Tiempo de Ejecución (Archivos locales/personales)
# ------------------------------------------------------------------------------
# Mapeos locales generados por el plugin
mappings.json
mappings.json.tmp
mappings.json.bak
*.bak
*.tmp

# Configuraciones locales de logros y sesiones de tiempo de juego
achievement_base_path.txt
achievement_paths.json
playtime_sessions.json
sessions.json
steam_appid.txt

# ------------------------------------------------------------------------------
# 4. Archivos Temporales, Capturas y Backups
# ------------------------------------------------------------------------------
capturas/
capturas*/
screenshots/
scratch/
temp/
tmp/
coverage/

# Scripts temporales o de pruebas locales
scratch_*.cjs
scratch_*.js
scratch_*.mjs
test_*.cjs
test_*.js
test_*.mjs
_*.py
_*.ps1
_*.cjs
_*.js

# Paquetes comprimidos y backups
*.zip
*.tar.gz
*.rar
*.7z

# ------------------------------------------------------------------------------
# 5. Salida de Compilación y Cachés de Herramientas
# ------------------------------------------------------------------------------
# Se permite .millennium/Dist/ para que el plugin funcione recién clonado/distribuido
!.millennium/Dist/

*.tsbuildinfo
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.eslintcache
.stylelintcache
.npm
*.tgz

# ------------------------------------------------------------------------------
# 6. Variables de Entorno y Secretos
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ------------------------------------------------------------------------------
# 7. Editores e IDEs
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosv
*.sln.docstates

# ------------------------------------------------------------------------------
# 8. Archivos del Sistema Operativo
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
