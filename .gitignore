# ==============================================================================
# GameBridge for Steam - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencias de Node.js y Gestores de Paquetes
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# 2. Registros y Logs
# ------------------------------------------------------------------------------
logs/
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Datos de Usuario y Estado en Tiempo de Ejecución (¡Nunca subir datos personales!)
# ------------------------------------------------------------------------------
# Mapeos locales de accesos directos generados por el plugin
mappings.json
mappings.json.tmp
mappings.json.bak
*.bak
*.tmp

# Configuraciones locales de logros de usuario y sesiones de tiempo de juego
achievement_base_path.txt
achievement_paths.json
playtime_sessions.json
sessions.json
steam_appid.txt

# ------------------------------------------------------------------------------
# 4. Carpetas y Archivos Locales / Descontinuados / Capturas
# ------------------------------------------------------------------------------
[g]ame-data-linker-DESCONTINUADO/
non-steam-playtimes-2.0.3/
*DESCONTINUADO*
*descontinuado*
capturas juegos nativos steam/
capturas*/
docs/
# README screenshots are release documentation and must be versioned.
!docs/
!docs/screenshots/
!docs/screenshots/*.png

# Archivos y carpetas temporales de pruebas y scratch
scratch/
scratch_*.cjs
test_*.cjs
copy_def.cjs
export_schema.cjs
_*.py
_*.ps1

# Paquetes comprimidos de backups
*.zip
*.tar.gz
*.rar
*.7z

# ------------------------------------------------------------------------------
# 5. Salida de Compilación y Cachés de Herramientas
# ------------------------------------------------------------------------------
# Nota: .millennium/Dist/ contiene el bundle listo para Millennium en Steam
# Si deseas ignorar Dist descomenta la siguiente línea:
# .millennium/Dist/
# Por defecto permitimos .millennium/Dist para que el plugin funcione recién clonado.
!.millennium/Dist/

*.tsbuildinfo
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.eslintcache
.stylelintcache
.npm
*.tgz

# ------------------------------------------------------------------------------
# 6. Variables de Entorno y Credenciales
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# 7. Editores e IDEs
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosv
*.sln.docstates

# ------------------------------------------------------------------------------
# 8. Archivos del Sistema Operativo
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
