{
	"scripts": {
		"dev": "node scripts/build-plugin.mjs dev",
		"build": "node scripts/build-plugin.mjs prod",
		"typecheck": "tsc --noEmit",
		"check:source": "node scripts/check-source.mjs",
		"check:localization": "node scripts/check-localization.mjs",
		"check:detection-fixtures": "node scripts/check-detection-fixtures.mjs",
		"check:artwork": "node scripts/check-artwork-rules.mjs",
		"check:lua": "node scripts/check-lua.mjs",
		"check:hardening": "node scripts/check-hardening.mjs",
		"check:detection-hardening": "node scripts/check-detection-hardening.mjs",
		"check:edge-cases": "node scripts/check-edge-cases.mjs",
		"check:hero": "node scripts/check-hero-policy.mjs",
		"check": "npm run typecheck && npm run check:source && npm run check:localization && npm run check:detection-fixtures && npm run check:detection-hardening && npm run check:hero && npm run check:artwork && npm run check:hardening && npm run check:edge-cases && npm run check:lua && npm run check:clean-install",
		"check:dist": "node scripts/check-dist.mjs",
		"verify": "npm run check && npm run build && npm run check:dist",
		"check:clean-install": "node scripts/check-clean-install.mjs",
		"package:prepare": "node scripts/prepare-release.mjs",
		"version:set": "node scripts/set-version.mjs"
	},
	"devDependencies": {
		"@babel/preset-env": "^7.28.3",
		"@babel/preset-react": "^7.27.1",
		"@babel/traverse": "^7.28.3",
		"@steambrew/ttc": "^3.3.7",
		"@types/react": "^19.1.12",
		"@types/react-dom": "^19.1.9",
		"@types/webpack": "^5.28.5",
		"luaparse": "^0.3.1"
	},
	"type": "module",
	"name": "nativegamelink-for-steam",
	"version": "4.0.0",
	"description": "Vincula juegos no-Steam con metadatos oficiales de Steam para mostrar datos reales en la biblioteca.",
	"main": "./frontend/index.tsx",
	"author": "David Miranda (Davidjarod11)",
	"license": "MIT",
	"dependencies": {
		"@steambrew/api": "^5.5.3",
		"@steambrew/client": "^5.5.3",
		"@steambrew/webkit": "^5.5.3"
	}
}
